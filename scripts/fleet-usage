#!/usr/bin/env python3
"""Print the board that ClaudeFleetBar exported, for shells and scripts.

Reads only the snapshot the app writes, so it never touches credentials itself.
"""
import datetime
import json
import os
import sys

SNAPSHOT = os.path.expanduser("~/.cache/claude-fleet-bar/usage.json")


def ago(iso, now):
    """Compact countdown to a future timestamp, or age of a past one."""
    if not iso:
        return "-"
    delta = int((datetime.datetime.fromisoformat(iso) - now).total_seconds())
    past = delta < 0
    secs = abs(delta)
    if secs < 60:
        return "now"
    days, hours, mins = secs // 86400, (secs % 86400) // 3600, (secs % 3600) // 60
    out = f"{days}d {hours}h" if days else (f"{hours}h {mins}m" if hours else f"{mins}m")
    return out


def pct(window):
    return f"{window['utilization']:.0f}%" if window else "--"


def board(data, now):
    head = f"  {'acct':<8}{'free':>5}   {'5h':>5} {'resets':>8}    {'7d':>5} {'resets':>8}   source"
    print(head)
    print("-" * len(head))
    for account in data["accounts"]:
        five = account.get("five_hour") or {}
        seven = account.get("seven_day") or {}
        free = account.get("headroom")
        mark = "▸" if account["label"] == data.get("recommended") else " "
        source = "live" if account.get("live") else (account.get("error") or "cached")
        free_text = f"{free:.0f}%" if free is not None else "--"
        print(
            f"{mark} {account['label']:<8}{free_text:>5}   "
            f"{pct(five):>5} {ago(five.get('resets_at'), now):>8}    "
            f"{pct(seven):>5} {ago(seven.get('resets_at'), now):>8}   {source}"
        )
    print()
    print("run order:", " › ".join(data["run_order"]))
    age = ago(data["generated_at"], now)
    print("snapshot: ", "just now" if age == "now" else f"{age} old")


def main():
    if not os.path.exists(SNAPSHOT):
        print(f"No snapshot at {SNAPSHOT} — is ClaudeFleetBar running?", file=sys.stderr)
        return 1

    with open(SNAPSHOT) as handle:
        data = json.load(handle)
    now = datetime.datetime.now(datetime.timezone.utc)

    command = sys.argv[1] if len(sys.argv) > 1 else "board"
    if command == "board":
        board(data, now)
    elif command == "best":
        print(data.get("recommended") or "")
    elif command == "order":
        print(" ".join(data["run_order"]))
    elif command == "json":
        print(json.dumps(data, indent=2))
    else:
        print("usage: fleet-usage [board|best|order|json]", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
